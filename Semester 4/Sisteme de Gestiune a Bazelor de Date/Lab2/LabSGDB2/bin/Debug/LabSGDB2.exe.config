	<appSettings>
		<add key="ConnectionString" value="Server=DESKTOP-5LU00PG\SQLEXPRESS;Database=AppleStore;Integrated Security=true;TrustServerCertificate=true"/>
		<add key="WindowTitle" value="Apple Store" />
		<add key="ParentTable" value="Clienti"/>
		<add key="ChildTable" value="Comenzi"/>
		<add key="ParentPrimaryKey" value="id_client"/>
		<add key="ChildForeignKey" value="id_client"/>
		<add key="ChildPrimaryKey" value="id_comanda"/>
		<add key="ParentColums" value="nume, email, nr_telefon"/>
		<add key="ChildColumns" value="id_comanda, id_client, cod_comanda, descriere, adresa"/>
		<add key="ParentQuery" value="SELECT * FROM Clienti"/>
		<add key="ChildQuery" value="SELECT id_comanda, id_client, cod_comanda, descriere, adresa FROM Comenzi WHERE id_client = @ParentId"/>
		<add key="ChildInsertQuery" value="INSERT INTO Comenzi (id_client, cod_comanda, descriere, adresa) VALUES (@ParentId, @cod_comanda, @descriere, @adresa)"/>
		<add key="ChildUpdateQuery" value="UPDATE Comenzi SET cod_comanda=@cod_comanda, descriere=@descriere, adresa=@adresa WHERE id_comanda = @PrimaryKeyValue"/>
		<add key="ChildDeleteQuery" value="DELETE from Comenzi WHERE id_comanda = @PrimaryKeyValue"/>
	</appSettings>
	

</configuration>


